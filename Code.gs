const SC={OWNER:'sabinaleonp@gmail.com',TZ:'Europe/Madrid',SHEETS:{CLIENTAS:['ID clienta','Nombre y apellidos','Teléfono','Email','Fecha de alta','Notas'],SERVICIOS:['ID servicio','Categoría','Servicio','Duración (min)','Precio visible','Activo'],RESERVAS:['ID reserva','Fecha','Hora inicio','Hora fin','ID servicio','Servicio (copia)','Duración reservada (min)','Precio visible (copia)','ID clienta','Nombre','Teléfono','Email','Estado','Origen','Creada el'],HORARIOS:['Día','Abierto','Apertura','Cierre'],BLOQUEOS:['ID bloqueo','Fecha','Hora inicio','Hora fin','Motivo','Activo'],CONFIGURACION:['Clave','Valor','Descripción']}};
const SC_SERVICES=[["mani-rusa","Manicura","Manicura rusa sin esmalte",30,"20 €","Sí"],["mani-trad","Manicura","Manicura + esmalte tradicional",45,"25 €","Sí"],["nude","Manicura","Manicura + Semi Nude",75,"35 €","Sí"],["color","Manicura","Manicura + Semi con color",90,"40 €","Sí"],["french","Diseños","Francesa / Pigmentos / Babyboomer",15,"5 €","Sí"],["design-extra","Diseños","Diseños complejos y otros",15,"Desde 5 €","Sí"],["gel-s","Relleno de gel","Relleno de gel · Cortas S",120,"Desde 45 €","Sí"],["gel-m","Relleno de gel","Relleno de gel · Medianas M",120,"Desde 50 €","Sí"],["gel-l","Relleno de gel","Relleno de gel · Largas L",150,"Desde 55 €","Sí"],["ext-s","Extensiones","Extensiones · Cortas S",120,"Desde 50 €","Sí"],["ext-m","Extensiones","Extensiones · Medianas M",150,"Desde 60 €","Sí"],["ext-l","Extensiones","Extensiones · Largas L",150,"Desde 70 €","Sí"],["ext-xl","Extensiones","Extensiones · Extra largas XL",180,"Desde 80 €","Sí"],["pedi-lam","Pedicura","Pedicura completa con láminas",120,"60 €","Sí"],["pedi-clean","Pedicura","Pedicura completa sin esmaltado",60,"40 €","Sí"],["pedi-semi","Pedicura","Pedicura completa + semipermanente",90,"50 €","Sí"],["pedi-toes","Pedicura","Pedicura solo dedos + semipermanente",60,"40 €","Sí"],["pedi-clean-toes","Pedicura","Solo limpieza de dedos",45,"30 €","Sí"],["pedi-heel","Pedicura","Solo limpieza de talón",30,"20 €","Sí"],["remove-semi","Otros servicios","Retirada de semi completa sin volver a esmaltar",30,"10 €","Sí"],["remove-gel","Otros servicios","Retirada de gel completa sin volver a esmaltar",40,"15 €","Sí"]];
function setupSabinaCalendar(){const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw new Error('Abre Apps Script desde la hoja de cálculo de Sabina.');Object.keys(SC.SHEETS).forEach(n=>{let s=ss.getSheetByName(n)||ss.insertSheet(n);if(s.getLastRow()===0){s.getRange(1,1,1,SC.SHEETS[n].length).setValues([SC.SHEETS[n]]);s.setFrozenRows(1);}});const s=ss.getSheetByName('SERVICIOS');if(s.getLastRow()<2)s.getRange(2,1,SC_SERVICES.length,6).setValues(SC_SERVICES);const h=ss.getSheetByName('HORARIOS');if(h.getLastRow()<2)h.getRange(2,1,7,4).setValues([['Lunes','Sí','09:30','21:30'],['Martes','Sí','09:30','21:30'],['Miércoles','Sí','09:30','21:30'],['Jueves','Sí','09:30','21:30'],['Viernes','Sí','09:30','21:30'],['Sábado','No','',''],['Domingo','No','','']]);const c=ss.getSheetByName('CONFIGURACION');if(c.getLastRow()<2)c.getRange(2,1,5,3).setValues([['email_propietario',SC.OWNER,'Cuenta propietaria'],['permitir_nuevas_clientas','Sí','Permitir primeras reservas online'],['margen_entre_citas_min','0','Margen entre citas'],['optimizacion_agenda','Destacar mejores huecos','Ordenar horarios recomendados'],['zona_horaria',SC.TZ,'Zona horaria']]);PropertiesService.getScriptProperties().setProperty('SABINA_SHEET_ID',ss.getId());return{ok:true,spreadsheetId:ss.getId(),sheets:Object.keys(SC.SHEETS)};}
function doGet(e){const p=(e&&e.parameter)||{};let o;try{if(p.action==='catalog')o={ok:true,services:rows_('SERVICIOS')};else if(p.action==='availability')o=availability_(p.date,p.serviceId);else o={ok:true,service:'Sabina Calendar API',state:'SETUP_REQUIRED'};}catch(x){o={ok:false,error:x.message};}const j=JSON.stringify(o);if(p.callback&&/^[A-Za-z_$][0-9A-Za-z_$.]*$/.test(p.callback))return ContentService.createTextOutput(p.callback+'('+j+')').setMimeType(ContentService.MimeType.JAVASCRIPT);return ContentService.createTextOutput(j).setMimeType(ContentService.MimeType.JSON);}
function doPost(e){let b;try{b=JSON.parse(e.postData.contents||'{}');}catch(x){return json_({ok:false,error:'Solicitud no válida.'});}try{if(b.action==='createBooking')return json_(createBooking_(b));return json_({ok:false,error:'Acción no reconocida.'});}catch(x){return json_({ok:false,error:x.message});}}
function createBooking_(b){const lock=LockService.getScriptLock();lock.waitLock(20000);try{const date=String(b.date||''),start=Number(b.start),sid=String(b.serviceId||''),name=String(b.name||'').trim(),phone=String(b.phone||'').trim(),email=String(b.email||'').trim().toLowerCase();if(!/^\d{4}-\d{2}-\d{2}$/.test(date)||!Number.isInteger(start)||!name||!phone||!/^\S+@\S+\.\S+$/.test(email))throw new Error('Completa nombre, teléfono, email, fecha y hora.');const ss=ss_(),services=rows_('SERVICIOS'),svc=services.find(x=>String(x[0])===sid&&String(x[5]).toLowerCase()==='sí');if(!svc)throw new Error('El servicio ya no está disponible.');const duration=Number(svc[3]),end=start+duration,hours=opening_(date);if(!hours||start<hours.start||end>hours.end)throw new Error('Horario fuera de apertura.');const cfg=config_(),clients=rows_('CLIENTAS'),known=clients.find(c=>String(c[2]).replace(/\s/g,'')===phone.replace(/\s/g,'')||String(c[3]).toLowerCase()===email);if(!known&&cfg.permitir_nuevas_clientas==='No')throw new Error('Las primeras citas deben solicitarse directamente a Sabina.');const margin=Number(cfg.margen_entre_citas_min||0),res=rows_('RESERVAS').filter(r=>String(r[1])===date&&!['CANCELADA','ANULADA'].includes(String(r[12]).toUpperCase()));if(res.some(r=>start<toMin_(r[3])+margin&&end>toMin_(r[2])-margin))throw new Error('Ese horario acaba de ocuparse.');const blocks=rows_('BLOQUEOS').filter(r=>String(r[1])===date&&String(r[5]).toLowerCase()==='sí');if(blocks.some(r=>start<toMin_(r[3])&&end>toMin_(r[2])))throw new Error('Ese horario está bloqueado.');const cid=known?String(known[0]):Utilities.getUuid();if(!known)ss.getSheetByName('CLIENTAS').appendRow([cid,name,phone,email,new Date(),'']);const id=Utilities.getUuid(),st=fromMin_(start),et=fromMin_(end);ss.getSheetByName('RESERVAS').appendRow([id,date,st,et,sid,svc[2],duration,svc[4],cid,name,phone,email,'CONFIRMADA','WEB',new Date()]);return{ok:true,bookingId:id,status:'CONFIRMADA',date,start:st,end:et,service:svc[2]};}finally{lock.releaseLock();}}
function availability_(date,sid){if(!/^\d{4}-\d{2}-\d{2}$/.test(String(date||'')))throw new Error('Fecha no válida.');const svc=rows_('SERVICIOS').find(x=>String(x[0])===String(sid)&&String(x[5]).toLowerCase()==='sí');if(!svc)throw new Error('Servicio no disponible.');const dur=Number(svc[3]),h=opening_(date);if(!h)return{ok:true,slots:[]};const res=rows_('RESERVAS').filter(r=>String(r[1])===date&&!['CANCELADA','ANULADA'].includes(String(r[12]).toUpperCase())),blocks=rows_('BLOQUEOS').filter(r=>String(r[1])===date&&String(r[5]).toLowerCase()==='sí'),margin=Number(config_().margen_entre_citas_min||0),slots=[];for(let t=h.start;t+dur<=h.end;t+=15){const end=t+dur,conflict=res.some(r=>t<toMin_(r[3])+margin&&end>toMin_(r[2])-margin)||blocks.some(r=>t<toMin_(r[3])&&end>toMin_(r[2]));if(!conflict)slots.push(fromMin_(t));}return{ok:true,slots};}
function opening_(iso){const d=new Date(iso+'T12:00:00'),day=['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'][d.getDay()],r=rows_('HORARIOS').find(x=>String(x[0])===day&&String(x[1]).toLowerCase()==='sí');return r?{start:toMin_(r[2]),end:toMin_(r[3])}:null;}
function rows_(n){const s=ss_().getSheetByName(n);return!s||s.getLastRow()<2?[]:s.getRange(2,1,s.getLastRow()-1,s.getLastColumn()).getValues();}
function config_(){const o={};rows_('CONFIGURACION').forEach(r=>o[String(r[0])]=String(r[1]));return o;}
function ss_(){const id=PropertiesService.getScriptProperties().getProperty('SABINA_SHEET_ID');if(!id)throw new Error('Ejecuta primero setupSabinaCalendar().');return SpreadsheetApp.openById(id);}
function toMin_(v){if(v instanceof Date)return v.getHours()*60+v.getMinutes();const p=String(v).split(':').map(Number);return(p[0]||0)*60+(p[1]||0);}
function fromMin_(m){return String(Math.floor(m/60)).padStart(2,'0')+':'+String(m%60).padStart(2,'0');}
function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}
